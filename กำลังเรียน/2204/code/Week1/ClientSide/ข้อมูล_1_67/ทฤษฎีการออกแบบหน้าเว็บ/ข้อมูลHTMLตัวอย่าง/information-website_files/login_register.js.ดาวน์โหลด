function optVerify(login_content){
    swal({
        title: lang.please_enter_otp_you_received_on_phone,
        input: 'text',
        inputAttributes: {
            autocapitalize: 'off'
        },
        showCancelButton: true,
        confirmButtonText: lang.submit,
        showLoaderOnConfirm: true,
        inputValidator: function(value) {                    
          return new Promise(function(resolve, reject) {
              if(value) resolve();
              else reject();
          });
      }
    }).then(function(result_otp) {
        $.ajax({
            type : 'post',
            url : action_url_phone_verify_otp,
            headers : {
              'X-CSRF-TOKEN' : window.Laravel.csrfToken,
              '_token' : window.Laravel.csrfToken,
            },
            beforeSend : function(){                        
                try{showHideLoaderAdmin('showLoader')}catch(er){console.log};
            },
            data : {'otp' : result_otp,'login_content':login_content,'login_option':'LOGIN_WITH_PHONE'},
            }).done(function(data){
                if(data.status && data.status == 'error')
                    _toastrMessage('error', data.message);
                else{
                    console.log(data);
                    if(data.url!=='undefined' && data.url!==''){
                        $('#reset_token').val(data.token);
                      $('#reset_login_phone').val(login_content);
                      $('#phone_resetModal').modal({show: true,backdrop: 'static'});
                      //window.location.href = data.url;
                    }else{
                      /*jQuery('#'+formId+' #btn_forget').prop("disabled", true);
                    _toastrMessage('success', 'Password reste link has been send to your email id.');*/
                      jQuery('#thanks_div').css("display","block");
                      jQuery('#'+formId+' #btn_forget').prop("disabled", true);
                      jQuery('#pageforgetForm').css("display","none");
                    }
                }
            });
    });
}

