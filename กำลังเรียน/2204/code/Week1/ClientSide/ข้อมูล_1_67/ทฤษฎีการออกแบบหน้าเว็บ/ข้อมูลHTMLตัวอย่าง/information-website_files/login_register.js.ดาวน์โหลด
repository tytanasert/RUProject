$('body').on('click',".btn_login",function(){
    
    var formId = $(this).closest('form').attr('id');
    var login_url = $('#'+formId).attr('action');
    var email_phone_username = $('#'+formId+' #email').val();
    var isEmail = IsEmail(email_phone_username);
    var isPhone = IsPhone(email_phone_username);
    var login_type = (isEmail) ? 'email' : 'username';

    if(email_phone_username == ''){
        $('#'+formId+' #email').css('border-color', 'red');
        $('#'+formId+' #email').focus();
        $(".blank_email").show();
        return false;
    }else{
        $(".blank_email").hide();
        $('#'+formId+' #email').css('border-color', '');
    }

    if($('#'+formId+' #password').val() == ''){
        $('#'+formId+' #password').css('border-color', 'red');
        $('#'+formId+' #password').focus();
        return false;
    }else{
        $('#'+formId+' #password').css('border-color', '');
    }

    if(isPhone){
        $.ajax({
            url: login_url,
            method: 'post',
            data: {
                email: email_phone_username,
                password: $('#password').val(),
                type: 'popup',
                login_type:'phone',
                _token: window.Laravel.csrfToken
            },
           
            success: function(result_login){
                //console.log(result_login);
                if(result_login.status == 'error'){
                    $('#login-error').html('<span class="error">'+result_login.message+'</span>');
                }

                if(result_login.status=='success'){
                    $('#loginModal').modal('hide'); 
                    var source = $('#btn-type').val();
                    if(source=='addwishlist'){
                        
                    }
                    else {
                        location.reload(true);
                    }
                }
                if(result_login.status=='resend_verify_email'){
                    $('#loginModal').modal('hide'); 
                    //$('#registerModal').modal('show');
                    //$('#resend_list_btn').show();
                    //jQuery('#resendEmailModal').modal('show');
                    $('#emailVerify').val(result_login.email);
                    $('#userResendEmail .modal-body #resendemail-body').show();
                    
                    $('#userRegister').hide();
                    $('#txt_resend').val(result_login.email);
                    $('#login-error').html(result_login.message);
                    $('#login-error').html('<div class="verify_msg">This account has not been verified.<br><a href="javascript:;" class="link-primary" data-toggle="modal" data-target="#registerModal">Click Here</a> Resend Email to Activate Account</div>');
                   
                    $('#info-msg').html(result_login.message);
                    $('#userResendEmail').show();
                
                }  
                               
            },
            error: function (login_error) {
                $('#login-error').html(login_error.responseJSON.errors.email[0]);
                var timeinsec = $('span#seconds_decrease').html(); 
                setInterval(function(){ 
                    timeinsec = Number(timeinsec)-1; 
                    if(timeinsec > 0){ 
                        $('span#seconds_decrease').html(timeinsec); 
                    }else{ 
                        $('#login-error').hide(); 
                    } 
                }, 30000);
            }
        })
        .always(function(){
            showHideLoader('hideLoader');
        });  
    }else{
        $.ajax({
            url: login_url,
            method: 'post',
            data: {
                email: $('#email').val(),
                password: $('#password').val(),
                login_type: login_type,
                type:'popup',
                product_id: $('#wish_product_id').val(),
                _token: window.Laravel.csrfToken
            },
            beforeSend: function(){
                showHideLoader('showLoader');
            },
            success: function(result){
                
                if(result.status=='success') {

                    $('#loginModal').modal('hide'); 

                    var source = $('#btn-type').val();
                    if(source=='addwishlist'){
                        
                    }
                    else {
                        //location.reload(true);
                        window.location = result.url;
                    }
                }
                else if(result.status == 'error'){

                    showHideLoader('hideLoader');
                    
                    $('#login-error').html('<span class="error">'+result.message+'</span>');
                }
                else if(result.status=='resend_verify_email') {

                    showHideLoader('hideLoader');

                    $('#loginModal').modal('hide'); 
                    //$('#registerModal').modal('show');
                    //$('#resend_list_btn').show();
                    //jQuery('#resendEmailModal').modal('show');
                    $('#emailVerify').val(result.email);
                    $('#userResendEmail .modal-body #resendemail-body').show();
                    
                    $('#userRegister').hide();
                    $('#txt_resend').val(result.email);
                    $('#login-error').html(result.message);
                    $('#login-error').html('<div class="verify_msg">This account has not been verified.<br><a href="javascript:;" class="link-primary" data-toggle="modal" data-target="#registerModal">Click Here</a> Resend Email to Activate Account<br>');
                   
                    $('#info-msg').html(result.message);
                    $('#userResendEmail').show();
                }              
            },
            error: function (error) {
                //console.log(error);
                showHideLoader('hideLoader');

                $('#login-error').html(error.responseJSON.errors.email[0]);
                var timeinsec = $('span#seconds_decrease').html(); 
                setInterval(function(){ 
                    timeinsec = Number(timeinsec)-1; 
                    if(timeinsec > 0){ 
                        $('span#seconds_decrease').html(timeinsec); 
                    }else{ 
                        $('#login-error').hide(); 
                    } 
                }, 30000);
            }
        })
        .always(function(){
            //showHideLoader('hideLoader');
        });
    }

});

