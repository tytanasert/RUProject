function initFooter(ww) {
    var allPanels = $('.footer-link-wrap ul');
    if (ww < 768) {
        allPanels.slideUp(10);
        $('.footer-link-wrap h3.title').off("click").on("click", function (e) {
            allPanels.slideUp(50);
            $('.footer-link-wrap h3.title').removeClass("active");
            if ($(this).next().css('display') == 'none') {
                $(this).next().slideDown(50);
                $(this).addClass("active");
                return false;
            }
        });
    } else {
        $('.footer-link-wrap h3.title').unbind("click");
        $('.footer-link-wrap h3.title').removeClass("active");
        allPanels.slideDown(10);
    }
}

function initMyaccount(ww) {
    var allPanels = $('.sidebar-menu');
    if (ww < 576) {
        allPanels.slideUp(10);
        $('.sidebar-heading').off("click").on("click", function (e) {
            allPanels.slideUp(50);
            $('.sidebar-heading').removeClass("active");
            if ($(this).next().css('display') == 'none') {
                $(this).next().slideDown(50);
                $(this).addClass("active");
                return false;
            }
        });
    } else {
        $('.sidebar-heading').unbind("click");
        $('.sidebar-heading').removeClass("active");
        allPanels.slideDown(10);
    }
}

function hiddenMenuBars(ww) {
    var loginWidth = ($(".footer-link-wrap").hasClass("has")) ? 120 : 0;
    var menuList = $(".main-menu");
    ww -= (170 + loginWidth);

    if (ww <= 145) {
        menuList.css('display', 'none');
    } else if (ww <= 200) {
        menuList.css('display', 'inline-block');
        menuList.eq(1).css('display', 'none');
        menuList.eq(2).css('display', 'none');
        menuList.eq(3).css('display', 'none');
    } else if (ww <= 310) {
        menuList.css('display', 'inline-block');
        menuList.eq(2).css('display', 'none');
        menuList.eq(3).css('display', 'none');
    } else if (ww <= 350) {
        menuList.css('display', 'inline-block');
        menuList.eq(3).css('display', 'none');
    } else {
        menuList.css('display', 'inline-block');
    }
}

