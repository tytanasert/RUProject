                //alert(cartId+'==='+item_remove_url);return;

                callAjaxRequest(item_remove_url,"post",data,function(result){

                        var response = jQuery.parseJSON(result); 

                        $('#totalCartProduct').html(response.totCart);

                        //swal('success', response.msg, 'success');
