function contact_send(){
	cname 	= jQuery( '.cname' ).val();
	cphone 	= jQuery( '.cphone' ).val();
	csafe 	= jQuery( '.chid' ).val();
	
	jQuery( '.cname-r' ).hide();
	jQuery( '.cphone-r' ).hide();
	
	if( ! csafe ){
		if( ! cname ){
			jQuery( '.cname-r' ).fadeIn();
			jQuery( '.cname' ).focus();
		}else if( ! cphone ){
			jQuery( '.cphone-r' ).fadeIn();
			jQuery( '.cphone' ).focus();
		}else{
			jQuery( '.contact2-title--submit button' ).prop( 'disabled', true );
			jQuery( '.contact2-title--submit button' ).html( '<i class="uk-icon-refresh uk-icon-spin"></i>' );
			
			jQuery.ajax({
				url				: ajaxurl,
				method			: "POST",
				data			: 
				{
					action		: 'contact_req',
					cname		: cname,
					cphone		: cphone,
				},
				success: function( data ) {
					jQuery( '.contact2-fill' ).remove();
					jQuery( '.contact2-success' ).fadeIn();
				} 
			});
		}
	}
}

function contact_new(){
	cname 	= jQuery( '.svcontact-input-name' ).val();
	cphone 	= jQuery( '.svcontact-input-tel' ).val();
	cmsg 	= jQuery( '.svcontact-input-msg' ).val();
	csafe 	= jQuery( '.svcontact-input-honey' ).val();
	ctitle 		= jQuery( '.svcontact-input-title' ).val();
	
	jQuery( '.svcontact-input-name-r' ).hide();
	jQuery( '.svcontact-input-tel-r' ).hide();
	jQuery( '.svcontact-input-msg-r' ).hide();
	
	if( ! csafe ){
		if( ! cname ){
			jQuery( '.svcontact-input-name-r' ).fadeIn();
			jQuery( '.svcontact-input-name' ).focus();
		}else if( ! cphone ){
			jQuery( '.svcontact-input-tel-r' ).fadeIn();
			jQuery( '.svcontact-input-tel' ).focus();
		}else if( ! cmsg ){
			jQuery( '.svcontact-input-msg-r' ).fadeIn();
			jQuery( '.svcontact-input-msg' ).focus();
		}else{
			jQuery( '.svcontact-box-submit' ).prop( 'disabled', true );
			jQuery( '.svcontact-input-name' ).prop( 'disabled', true );
			jQuery( '.svcontact-input-tel' ).prop( 'disabled', true );
			jQuery( '.svcontact-box-submit' ).html( '<i class="uk-icon-refresh uk-icon-spin"></i>' );
			
			jQuery.ajax({
				url				: ajaxurl,
				method			: "POST",
				data			: 
				{
					action		: 'contact_new',
					cname		: cname,
					cphone		: cphone,
					cmsg			: cmsg,
					ctitle			: ctitle,
				},
				success: function( data ) {
					jQuery( '.svcontact-box-content--right-head_msg' ).remove();
					jQuery( '.svcontact-box-content--right-head_btn' ).remove();
					jQuery( '.svcontact-box-ss' ).fadeIn();
				} 
			});
		}
	}
}
