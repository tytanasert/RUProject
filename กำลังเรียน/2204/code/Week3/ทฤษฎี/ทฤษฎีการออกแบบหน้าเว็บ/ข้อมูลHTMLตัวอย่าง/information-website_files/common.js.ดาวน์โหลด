//for increment decrement
var Event_Type = 'ontouchend' in document ? 'touchend' : 'click';
jQuery(document).on(Event_Type, '.spiner span, .spinergroup span', function(event) {
    event.preventDefault();
    //console.log(jQuery(this).parent().find('.quantity'));
    var textVal = 0;
    if (jQuery(this).hasClass('increase')) {
        textVal = parseInt(jQuery(this).parent().find('.spinNum').val());
        var maxVal = parseInt(jQuery(this).parent().find('.spinNum').attr('max'));
        if (textVal < maxVal) {
            textVal++;
            jQuery(this).parent().find('.spinNum').val(textVal);
        }
    } else if (jQuery(this).hasClass('decrease')) {
        textVal = parseInt(jQuery(this).parent().find('.spinNum').val());
        var minVal = parseInt(jQuery(this).parent().find('.spinNum').attr('min'));
        if (textVal > minVal) {
            textVal--;
            jQuery(this).parent().find('.spinNum').val(textVal);
        }
    }
});

$('body').on('blur','.spinNum',function(){

    var input_val = $(this).val();
    var input_max_val = $(this).attr('max');
    var input_min_val = $(this).attr('min');    
    
    //alert(input_val+'==='+input_max_val);
    if(input_val > input_max_val || input_val < input_min_val || isNaN(input_val)) {
        $(this).val(input_max_val);
    }
});
//for increment decrement ended

