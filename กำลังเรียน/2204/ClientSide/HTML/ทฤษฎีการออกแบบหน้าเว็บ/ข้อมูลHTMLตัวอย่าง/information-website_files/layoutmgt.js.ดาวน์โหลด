/********for flash timer*******/
function checkFlashSale(){
    if($('.flashsale-timer').length){
        $.each($('.flashsale-timer'), function(){
            // var endt = $(this).data('enddate').replace(' ', 'T');
            var show_timer = $(this).data('show-timer');
            if(show_timer == 1 || show_timer == '1'){
                var s = $(this).data('end');
                var a = s.split(/[^0-9]/);
                //for (i=0;i<a.length;i++) { alert(a[i]); }
                var d=new Date (a[0],a[1]-1,a[2],a[3],a[4],a[5] );
                //console.log(d);
                countdownTimer($(this), d);
            }else{
                $(this).find('.countdown-inner').html(lang_coming_soon);
            }
            // countdownTimer($(this), endt);
        });
    }
}

function countdownTimer(elem, endtime){
    var countDownDate = /*new Date(endtime)*/endtime.getTime();
    var timerInterval = setInterval(function(){
        // Get today's date and time
        var now = new Date().getTime();
        // Find the distance between now and the count down date
        var distance = countDownDate - now;
        // Time calculations for days, hours, minutes and seconds
        var days = Math.floor(distance / (1000 * 60 * 60 * 24)) || '00';
        var hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)) || '00';
        var minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60)) || '00';
        var seconds = Math.floor((distance % (1000 * 60)) / 1000) || '00';

        
        if(days>0){
            elem.find('.countdown-inner .days').html(days);
        }else{
            elem.find('.countdown-inner .days').remove();
        }
        if(hours>=0){
            elem.find('.countdown-inner .hours').html(hours);
        }

        if(minutes>=0){
            elem.find('.countdown-inner .minutes').html(minutes);
        }

        if(seconds>=0){
            elem.find('.countdown-inner .seconds').html(seconds);
        }
        
        // If the count down is finished, write some text 
        if (distance < 0) {
            clearInterval(timerInterval);
            //document.getElementById("demo").innerHTML = "EXPIRED";
        }
    }, 1000);
};


