function flashsalePrice(price,flashsale_data){
    var in_price = parseInt(price);
    if(flashsale_data.discount_type == 'percentage'){
        var discount = ((in_price * flashsale_data.discount)/100);
        var price_val = in_price - discount;
    }else{
        var price_val = in_price - flashsale_data.discount;
    }

    if(flashsale_data.mask_price == 'show_mask'){
        var mash_text = '?';
        var intprice = price_val.toString();
        var pricelen = intprice.length;
        if(pricelen > 2){
            var ret_price   = intprice.substring(0, 1) + intprice.substring(1, pricelen-1).replace(/\d/g, mash_text) + intprice.substring(pricelen-1);
        }else{
            var ret_price = intprice;
        }
        return ret_price;
    }else{
        return price_val;
    }
}


